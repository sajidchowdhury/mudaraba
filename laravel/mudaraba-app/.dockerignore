# =============================================================================
# Docker build context exclusions
# Reduces build time + image size by skipping files not needed in the image
# =============================================================================

# Version control
.git
.gitignore
.gitattributes

# IDE / editor
.idea
.vscode
.cursor
.zed
.nova
.codex
.DS_Store
*.swp
*~

# Dependencies (installed inside the container)
node_modules
vendor

# Build artifacts (regenerated in container)
public/build
public/hot
public/fonts-manifest.dev.json

# Environment files (mounted / generated in container)
.env
.env.backup
.env.production
.env.docker
.env.docker.local

# Logs + cache
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/pail
bootstrap/cache/*.php
!bootstrap/cache/.gitignore

# Test artifacts
.phpunit.cache
.phpunit.result.cache
tests/*/snapshots

# Docker compose files (not needed inside the image — but KEEP docker/ dir
# because the Dockerfile COPYs php.ini + entrypoint.sh from it)
docker-compose.yml
docker-compose.override.yml

# Documentation (not needed inside image)
*.md
docs

# Misc
Homestead.json
Homestead.yaml
auth.json
phpstan.neon
phpstan-baseline.neon
_ide_helper.php
.phpactor.json
