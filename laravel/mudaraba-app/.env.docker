# =============================================================================
# Mudaraba Docker Environment
# This file provides defaults for docker-compose.yml.
# Copy to .env or just run `docker compose up -d --build` — the entrypoint
# will create .env from .env.example automatically.
# =============================================================================

# App
APP_NAME=Mudaraba
APP_PORT=8080

# Database (PostgreSQL)
DB_DATABASE=mudaraba
DB_USERNAME=mudaraba
DB_PASSWORD=secret
FORWARD_DB_PORT=5432

# Vite
VITE_PORT=5173

# Xdebug (optional)
XDEBUG_MODE=off
