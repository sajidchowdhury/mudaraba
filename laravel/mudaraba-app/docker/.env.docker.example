# =============================================================================
# Mudaraba Docker Environment
# Copy to .env.docker and customize, OR set these in your shell before
# running `docker compose up`.
#
# These values override the project's .env when running in Docker.
# The docker-compose.yml file reads from the host environment + .env file.
# =============================================================================

# --- App ---
APP_NAME=Mudaraba
APP_PORT=8080
APP_KEY=

# --- Database (PostgreSQL) ---
DB_DATABASE=mudaraba
DB_USERNAME=mudaraba
DB_PASSWORD=secret
FORWARD_DB_PORT=5432

# --- Vite ---
VITE_PORT=5173

# --- Xdebug (optional) ---
XDEBUG_MODE=off
